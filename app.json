{
  "expo": {
    "name": "Tidix",
    "slug": "tidix",
    "scheme": "tidix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tidix.app"
    },
    "android": {
      "package": "com.tidix.app",
      "adaptiveIcon": {
        "backgroundColor": "#EDEFE9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "lang": "it",
      "themeColor": "#EDEFE9",
      "description": "Gestione scorte, lista della spesa, pulizie e spese di casa"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-splash-screen", { "backgroundColor": "#EDEFE9", "image": "./assets/splash-icon.png" }],
      ["expo-notifications", { "icon": "./assets/android-icon-monochrome.png", "color": "#4F6B47" }],
      "@react-native-community/datetimepicker",
      "expo-image-picker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Consenti a Tidix di usare il microfono per compilare i campi a voce.",
          "speechRecognitionPermission": "Consenti a Tidix di riconoscere il parlato per compilare i campi a voce."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a1ad499-f252-46f1-8647-fb1c2231814d"
      }
    }
  }
}
